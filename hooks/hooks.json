{
  "description": "Development hooks: ruff for Python, yamllint for YAML",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/ruff-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/yamllint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
